{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "my-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run lint:check && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run lint:check && NODE_OPTIONS='-r tsconfig-paths/register' nest start",
    "start:dev": "npm run lint:check && NODE_OPTIONS='-r tsconfig-paths/register' nest start --watch",
    "start:debug": "npm run lint:check && NODE_OPTIONS='-r tsconfig-paths/register' nest start --debug --watch",
    "start:prod": "npm run lint:check && npm run build && node -r tsconfig-paths/register dist/main",
    "start:safe": "./scripts/validate-and-run.sh",
    "start:safe:dev": "./scripts/validate-and-run.sh dev",
    "start:safe:debug": "./scripts/validate-and-run.sh debug",
    "start:safe:prod": "./scripts/validate-and-run.sh prod",
    "start:watch": "node scripts/eslint-watcher.js",
    "start:watch:bash": "./scripts/watch-with-eslint.sh",
    "build:safe": "./scripts/validate-and-run.sh build",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prelint": "echo 'Verificando código con ESLint...'",
    "prestart": "echo 'Iniciando validación de código...'",
    "prestart:dev": "echo 'Iniciando validación de código para desarrollo...'",
    "prestart:debug": "echo 'Iniciando validación de código para debug...'",
    "prestart:prod": "echo 'Iniciando validación de código para producción...'",
    "prebuild": "echo 'Iniciando validación de código para build...'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "generate:module": "./scripts/generate-module.sh",
    "generate:quick": "./scripts/quick-module.sh",
    "g:module": "./scripts/generate-module.sh",
    "g:quick": "./scripts/quick-module.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@nestjs/common": "^11.1.8",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.8",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.1.8",
    "@nestjs/platform-fastify": "^11.1.8",
    "@nestjs/typeorm": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "jsonwebtoken": "^9.0.2",
    "nest-winston": "^1.10.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.8",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.12",
    "@types/supertest": "^6.0.3",
    "chokidar": "^4.0.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^61.0.2",
    "fastify": "^5.6.1",
    "globals": "^16.4.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-model-generator": "^0.4.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@app/(.*)": "<rootDir>/$1",
      "^@common/(.*)": "<rootDir>/common/$1",
      "^@modules/(.*)": "<rootDir>/modules/$1",
      "^@config/(.*)": "<rootDir>/../config/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
